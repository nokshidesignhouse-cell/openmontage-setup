# OpenMontage Configuration

# Optional: API Keys (leave blank for free/offline mode)
GOOGLE_VEO_API_KEY=
RUNWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Video Settings
VIDEO_OUTPUT_DIR=./output
VIDEO_QUALITY=1080p
VIDEO_FPS=30

# TTS Settings (Text-to-Speech)
TTS_ENGINE=piper
TTS_VOICE=en_US-amy-medium

# Stock Footage Sources
USE_PEXELS=true
USE_PIXABAY=true
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false
